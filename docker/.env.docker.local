NEXT_HOST=dataflow-ide.local
WEBSOCKET_HOST=ws.$NEXT_HOST
NEXT_PUBLIC_BASE_URL=http://$NEXT_HOST
NEXTAUTH_SECRET=42Secret
NEXTAUTH_URL=$NEXT_PUBLIC_BASE_URL
NEXT_PUBLIC_WEBSOCKET_SERVER_URL=ws://$WEBSOCKET_HOST
WEBSOCKET_SERVER_URL=ws://ws-gateway:3001 # Do not override this setting in later .env files !
NATS_SERVER_URL=nats://nats:4222 # Do not override this setting in later .env files !
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_URI=mongodb://$MONGO_INITDB_ROOT_USERNAME:$MONGO_INITDB_ROOT_PASSWORD@mongodb:27017/dataflow
ME_CONFIG_MONGODB_URL=mongodb://$MONGO_INITDB_ROOT_USERNAME:$MONGO_INITDB_ROOT_PASSWORD@mongodb:27017/
ME_CONFIG_BASICAUTH="true"
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=password
GATEWAY_URL=http://ws-gateway:3001 # Do not override this setting in later .env files !
