{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@dataflow-ui/*": ["../../libs/dataflow-ui/src/lib/*"],
      "@dataflow-ide/dataflow-core": ["../../libs/dataflow-core/dist/core/index"],
      "@dataflow-ide/dataflow-backend": ["../../libs/dataflow-backend/dist/index"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "vitest.config.mts", "types"],
  "exclude": ["node_modules"]
}
